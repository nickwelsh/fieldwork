{
    "name": "@formbraid/docs",
    "private": true,
    "type": "module",
    "scripts": {
        "generate:api": "refquill generate refquill.json",
        "dev": "pnpm generate:api && docs-base dev",
        "build": "pnpm generate:api && docs-base build && node package-worker.ts",
        "start": "docs-base start",
        "check": "tsc --noEmit",
        "test": "node verify-worker.ts",
        "deploy:check": "cf deploy --prebuilt --mode production --dry-run",
        "deploy": "cf deploy --prebuilt --mode production"
    },
    "dependencies": {
        "@nickwelsh/docs-base": "1.0.0",
        "fumadocs-core": "16.17.5",
        "fumadocs-mdx": "15.4.7",
        "fumadocs-ui": "npm:@fumadocs/base-ui@16.17.5",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "react-server-dom-webpack": "19.3.1",
        "waku": "1.0.0-rc.3"
    },
    "devDependencies": {
        "@cloudflare/build-output-utils": "0.9.2",
        "@nickwelsh/refquill": "0.1.0",
        "@nickwelsh/refquill-schema": "0.1.0",
        "@types/node": "^24.13.3",
        "cf": "1.0.0-beta.17",
        "miniflare": "5.20261012.0-beta",
        "typescript": "^7.0.2"
    }
}
