{
    "name": "@formbraid/react",
    "version": "0.1.0",
    "description": "Typed React bindings and application-owned components for Formbraid.",
    "homepage": "https://docs.nickwelsh.me/formbraid/",
    "bugs": {
        "url": "https://github.com/nickwelsh/formbraid/issues"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/nickwelsh/formbraid.git",
        "directory": "packages/react"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./generator": {
            "types": "./dist/generator.d.ts",
            "import": "./dist/generator.js"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "vp pack"
    },
    "dependencies": {
        "@formbraid/core": "workspace:*",
        "effect": "4.0.2"
    },
    "devDependencies": {
        "@formbraid/generator": "workspace:*"
    },
    "peerDependencies": {
        "@formbraid/generator": "^0.1.0",
        "react": "^19.0.0"
    },
    "peerDependenciesMeta": {
        "@formbraid/generator": {
            "optional": true
        }
    }
}
