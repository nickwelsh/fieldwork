{
    "name": "fieldwork/laravel",
    "description": "Generate portable Fieldwork forms from Laravel FormRequests.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/console": "^12.0 || ^13.0",
        "illuminate/filesystem": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/routing": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "illuminate/validation": "^12.0 || ^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^12.0",
        "phpstan/phpstan": "^2.1",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Fieldwork\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fieldwork\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Fieldwork\\Laravel\\FieldworkServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "check": "phpstan analyse --memory-limit=1G",
        "format": "pint --test"
    }
}
