{
    "name": "@formbraid/laravel",
    "version": "0.1.0",
    "description": "Node generator integration for Laravel FormRequests.",
    "homepage": "https://docs.nickwelsh.me/formbraid/",
    "bugs": {
        "url": "https://github.com/nickwelsh/formbraid/issues"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/nickwelsh/formbraid.git",
        "directory": "packages/laravel"
    },
    "files": [
        "dist",
        "bin"
    ],
    "type": "module",
    "exports": {
        "./generator": {
            "types": "./dist/generator.d.ts",
            "import": "./dist/generator.js"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "vp pack"
    },
    "dependencies": {
        "@formbraid/core": "workspace:*",
        "effect": "4.0.2"
    },
    "devDependencies": {
        "@effect/platform-node": "4.0.2",
        "@formbraid/generator": "workspace:*"
    },
    "peerDependencies": {
        "@formbraid/generator": "^0.1.0"
    },
    "engines": {
        "node": ">=24.11.0"
    }
}
